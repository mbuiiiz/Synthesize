{
  "name": "@synthesize/extension",
  "version": "0.1.0",
  "private": true,
  "displayName": "Synthesize",
  "description": "Capture useful web research into a shared team knowledge base.",
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "manifest": {
    "minimum_chrome_version": "127",
    "permissions": [
      "activeTab",
      "scripting",
      "sidePanel",
      "storage"
    ],
    "host_permissions": [
      "http://*/*",
      "https://*/*"
    ],
    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "action": {
      "default_title": "Open Synthesize",
      "default_popup": "popup.html"
    },
    "commands": {
      "capture-selection": {
        "suggested_key": {
          "default": "Ctrl+Shift+Y",
          "mac": "Command+Shift+Y"
        },
        "description": "Capture highlighted text"
      }
    }
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "@synthesize/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "plasmo": "^0.90.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "10",
    "postcss": "8",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2"
  }
}
